<UserControl x:Class="RoadProto.Terrain.UI.Agent.AgentConsolePalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="340"
             MinHeight="520"
             Background="#F7F9FC"
             FocusManager.IsFocusScope="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Provider" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ProviderBox"
                          Width="102"
                          Height="28"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Padding="4,0"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Agent 控制台" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="{Binding BackendStatus}" Foreground="#4B5563" FontSize="12" />
                <TextBlock Text="{Binding TraceId, StringFormat=TraceId: {0}}" Foreground="#4B5563" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="模型设置" Margin="0,0,0,8">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="BaseUrl" VerticalAlignment="Center" />
                <TextBox x:Name="BaseUrlBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         MinWidth="180"
                         Text="{Binding ProviderBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" Margin="0,4,0,0" />
                <TextBox x:Name="ModelBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         Margin="0,4,0,0"
                         Text="{Binding ProviderModel, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Text="API Key" VerticalAlignment="Center" Margin="0,4,0,0" />
                <PasswordBox x:Name="ApiKeyBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             Margin="0,4,0,0" />

                <CheckBox Grid.Row="3"
                          Grid.Column="1"
                          Margin="0,6,0,0"
                          IsChecked="{Binding ProviderEnabled}"
                          Content="启用" />
                <StackPanel Grid.Row="3"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="8,4,0,0">
                    <Button x:Name="OpenRoadProtoLogsButton"
                            Width="74"
                            Content="日志目录"
                            Click="OnOpenRoadProtoLogsClick" />
                    <Button x:Name="SaveProviderButton"
                            Width="68"
                            Margin="6,0,0,0"
                            Content="保存"
                            Click="OnSaveProviderClick" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="MessageList"
                     Grid.Row="0"
                     Text="{Binding MessagesText}"
                     BorderBrush="#D9E1EC"
                     Background="White"
                     Padding="8"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <Border Grid.Row="1"
                    Margin="0,6,0,0"
                    Padding="8"
                    Background="#EEF4FF"
                    BorderBrush="#BFD2F8"
                    BorderThickness="1"
                    Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="10,0,0,0">
                        <Button Width="76"
                                Content="确认执行"
                                Click="OnConfirmClick" />
                        <Button Width="64"
                                Margin="6,0,0,0"
                                Content="取消"
                                Click="OnCancelClick" />
                    </StackPanel>
                    <TextBlock Text="本次操作需要确认"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#1F2937" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     MinHeight="32"
                     VerticalContentAlignment="Center"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     InputMethod.IsInputMethodEnabled="True"
                     PreviewMouseDown="OnInputPreviewMouseDown"
                     PreviewKeyDown="OnInputPreviewKeyDown" />
            <Button Grid.Column="1"
                    Width="68"
                    Margin="8,0,0,0"
                    Content="发送"
                    Click="OnSendClick" />
        </Grid>

        <GroupBox Grid.Row="4" Header="流转日志">
            <TextBox x:Name="LogList"
                     Text="{Binding LogText}"
                     BorderThickness="0"
                     Background="#FBFCFE"
                     Padding="6"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </GroupBox>
    </Grid>
</UserControl>
